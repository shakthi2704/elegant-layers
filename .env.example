# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection used by the app, the seed and scripts (pooled URL on Neon).
DATABASE_URL=

# Direct (non-pooled) connection used only by Prisma migrations.
DIRECT_URL=

# Long random string, different for every environment.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public address of this deployment, exactly as typed in the browser,
# for example http://localhost:3000 or https://your-domain.com
BETTER_AUTH_URL=

# Cloudinary (cake photos). Create an UNSIGNED upload preset in Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=