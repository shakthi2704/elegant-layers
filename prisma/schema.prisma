// prisma/schema.prisma  (DRAFT — for review)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  CASHIER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum Unit {
  KG
  G
  L
  ML
  PCS
}

enum InventoryItemType {
  INGREDIENT
  PRODUCT
}

enum InventoryTransactionType {
  PURCHASE
  PRODUCTION_IN
  PRODUCTION_OUT
  SALE
  WASTE
  ADJUSTMENT
}

enum SaleStatus {
  HELD
  COMPLETED
  VOID
}

enum SaleType {
  DINE_IN
  TAKEAWAY
}
enum CakeOrderStatus {
  PENDING
  IN_PROGRESS
  READY
  COLLECTED
  CANCELLED
}

enum AssetStatus {
  ACTIVE
  DISPOSED
}

enum PaymentMethod {
  CASH
  BANK_DEPOSIT
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)   // NEW
  image         String?                    // NEW
  role          Role     @default(CASHIER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt         // NEW

  accounts  Account[]                       // NEW
  sessions  Session[]                       // NEW

  purchasesCreated     Purchase[]
  productionsRecorded  Production[]
  sales                Sale[]  @relation("CashierSales")
    voidedSales          Sale[]  @relation("VoidedSales")
  inventoryTxns        InventoryTransaction[]
  cakeOrdersCreated    CakeOrder[]
  expensesRecorded     Expense[]
  fixedAssetsRecorded  FixedAsset[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id                String        @id @default(cuid())
  name              String
  sku               String        @unique
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id])
  sellingPrice      Decimal       @db.Decimal(10, 2)
  isFinishedProduct Boolean       @default(true) // tracks stock via Production; false = sold directly, no stock tracking
  status            ProductStatus @default(ACTIVE)
  currentStock      Decimal       @default(0) @db.Decimal(10, 3)
  minimumStock      Decimal       @default(0) @db.Decimal(10, 3)
  unit              Unit          @default(PCS)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  productRecipes    ProductRecipe[]
  saleItems         SaleItem[]
  productionItems   ProductionItem[]
    purchaseItems     PurchaseItem[]
  inventoryTxns     InventoryTransaction[]
  cakeOrders        CakeOrder[]

  components        ProductComponent[] @relation("ParentComponents")   // bases (and quantities) this product needs
  usedAsComponentIn ProductComponent[] @relation("ComponentUsedIn")    // other products that use this one as a base
}

model Ingredient {
  id              String   @id @default(cuid())
  name            String   @unique
  unit            Unit
  currentStock    Decimal  @default(0) @db.Decimal(10, 3)
  minimumStock    Decimal  @default(0) @db.Decimal(10, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipeItems     RecipeItem[]
  purchaseItems   PurchaseItem[]
  inventoryTxns   InventoryTransaction[]
}

// ============================================================
// RECIPES
// ============================================================

// ============================================================
// RECIPES
// ============================================================

model Recipe {
  id        String          @id @default(cuid())
  name      String          @unique // e.g. "Butter Cake Base", "Vanilla Icing" — reusable, not tied to one product
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  items     RecipeItem[]
  products  ProductRecipe[]
}

model RecipeItem {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(10, 3) // amount of ingredient needed per 1 unit of the recipe's output

  @@unique([recipeId, ingredientId])
}

// Join table: which recipe components make up a given product, and how many
// of each (e.g. Iced Butter Cake = 1x Butter Cake Base + 1x Vanilla Icing).
model ProductRecipe {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id])
  quantity  Decimal  @default(1) @db.Decimal(10, 3) // multiplier — e.g. 2 = double icing
  createdAt DateTime @default(now())

  @@unique([productId, recipeId])
}

// Join table: which other products (bases) a finished product requires, and
// how many of each (e.g. Layered Naked Cake = 1x Vanilla Base 1kg + 1x Chocolate Base 1kg).
// A component product may not itself have components attached (enforced in app logic,
// not the DB) — bases stay one level deep: ingredients -> base -> finished product.
model ProductComponent {
  id                 String   @id @default(cuid())
  parentProductId    String
  parentProduct      Product  @relation("ParentComponents", fields: [parentProductId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product  @relation("ComponentUsedIn", fields: [componentProductId], references: [id])
  quantity           Decimal  @default(1) @db.Decimal(10, 3) // units of the component needed per 1 unit of the parent
  createdAt          DateTime @default(now())

  @@unique([parentProductId, componentProductId])
}

// ============================================================
// SUPPLIERS & PURCHASES
// ============================================================

model Supplier {
  id        String     @id @default(cuid())
  name      String
  contact   String?
  address   String?
  createdAt DateTime   @default(now())

  purchases Purchase[]
}

model Purchase {
  id           String         @id @default(cuid())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  purchaseDate DateTime       @default(now())
  totalAmount  Decimal        @db.Decimal(10, 2)
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())

  items        PurchaseItem[]
}

model PurchaseItem {
  id           String     @id @default(cuid())
  purchaseId   String
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
   itemType     InventoryItemType @default(INGREDIENT)         // NEW — INGREDIENT or PRODUCT
  ingredientId String?                    // now optional
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  productId    String?                    // NEW
  product      Product?   @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(10, 3)
  unitCost     Decimal    @db.Decimal(10, 2)
  subtotal     Decimal    @db.Decimal(10, 2)
}
// ============================================================
// PRODUCTION
// ============================================================

model Production {
  id             String           @id @default(cuid())
  productionDate DateTime         @default(now())
  notes          String?
  producedById   String
  producedBy     User             @relation(fields: [producedById], references: [id])
  createdAt      DateTime         @default(now())

  items          ProductionItem[]
}

model ProductionItem {
  id                String     @id @default(cuid())
  productionId      String
  production        Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  quantityProduced  Decimal    @db.Decimal(10, 3)
}

// ============================================================
// INVENTORY LEDGER  (source of truth for every stock movement)
// ============================================================

model InventoryTransaction {
  id             String                    @id @default(cuid())
  itemType       InventoryItemType
  ingredientId   String?
  ingredient     Ingredient?               @relation(fields: [ingredientId], references: [id])
  productId      String?
  product        Product?                  @relation(fields: [productId], references: [id])
  type           InventoryTransactionType
  quantity       Decimal                   @db.Decimal(10, 3) // signed: +in / -out
  balanceAfter   Decimal                   @db.Decimal(10, 3)
  referenceType  String?                   // "PURCHASE" | "PRODUCTION" | "SALE" | "CAKE_ORDER" | "MANUAL"
  referenceId    String?
  note           String?
  createdById    String
  createdBy      User                      @relation(fields: [createdById], references: [id])
  createdAt      DateTime                  @default(now())

  @@index([ingredientId])
  @@index([productId])
  @@index([type])
}

// ============================================================
// SALES / POS
// ============================================================

model Sale {
  id            String     @id @default(cuid())
  saleNumber    String     @unique
  status        SaleStatus @default(COMPLETED)
  type          SaleType   @default(TAKEAWAY)
  holdLabel     String?
  subtotal      Decimal    @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  total         Decimal    @db.Decimal(10, 2)
  cashReceived  Decimal?   @db.Decimal(10, 2)
  changeGiven   Decimal?   @db.Decimal(10, 2)
  cashierId     String
  cashier       User       @relation("CashierSales", fields: [cashierId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  voidReason    String?
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?      @relation("VoidedSales", fields: [voidedById], references: [id])

  items         SaleItem[]
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(10, 3)
  unitPrice  Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)
}

// ============================================================
// CAKE ORDERS
// ============================================================

model Customer {
  id        String      @id @default(cuid())
  name      String
  phone     String      @unique
  createdAt DateTime    @default(now())

  cakeOrders CakeOrder[]
}

model CakeOrder {
  id            String          @id @default(cuid())
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id])
  cakeName      String          // free text if not tied to a fixed Product
  shape         String?         // NEW — free text, e.g. "Round", "Heart", "2-tier square"
  weight        String?
  message       String?
  imageUrl      String?         // NEW — Cloudinary secure_url for the customer's reference photo
  pickupDate    DateTime
  pickupTime    String
  status        CakeOrderStatus @default(PENDING)
  price         Decimal?        @db.Decimal(10, 2)
  advancePaid   Decimal?        @db.Decimal(10, 2)
  paymentMethod PaymentMethod?  // NEW — how the advance (if any) was paid
  notes         String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  category    String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  recordedById String
  recordedBy  User     @relation(fields: [recordedById], references: [id])
  createdAt   DateTime @default(now())
}



// ============================================================
// FIXED ASSETS
// ============================================================

model FixedAsset {
  id               String      @id @default(cuid())
  name             String
  category         String?     // free text, e.g. "Kitchen Equipment", "Furniture" — no separate management page for now
  purchaseDate     DateTime
  purchaseCost     Decimal     @db.Decimal(10, 2)
  salvageValue     Decimal     @default(0) @db.Decimal(10, 2)
  usefulLifeMonths Int
  status           AssetStatus @default(ACTIVE)
  disposalDate     DateTime?
  notes            String?
  createdById      String
  createdBy        User        @relation(fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}


// ============================================================
// SETTINGS
// ============================================================

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}